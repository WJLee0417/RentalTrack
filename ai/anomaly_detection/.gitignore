.venv/
__pycache__/
*.pyc

# 모델 가중치 / 실행 산출물
*.pt
runs/
*.mp4

# 원본 촬영본 — 사람 얼굴 포함 여부를 자동 검출로 100% 보장할 수 없다.
# 실제로 학습에 쓰는 train/good, test/good (사람 미검출로 확인된 것만) 만 버전관리 대상이다.
# datasets/umbrella/train/, datasets/umbrella/test/는 아래에서 명시적으로 다시 허용한다.
datasets/*.zip
datasets/umbrella/*.jpg
datasets/umbrella/*.jpeg
datasets/umbrella/*.png
!datasets/umbrella/train/**
!datasets/umbrella/test/**

# datasets/umbrella_yellow(2026-07 데모 우산) — 위와 동일 원칙. train/test만 버전관리
# 대상이고, 진단용 아카이브 폴더(_archive_*)는 이미 폐기된 실험 결과라 제외한다.
datasets/umbrella_yellow/*.jpg
datasets/umbrella_yellow/*.jpeg
datasets/umbrella_yellow/*.png
!datasets/umbrella_yellow/train/**
!datasets/umbrella_yellow/test/**
datasets/*/_archive_*/

# capture_umbrella.py 원본 백업(크롭 전 프레임) — 어떤 데이터셋 폴더 아래든 로컬 전용,
# 커밋 대상에서 원천 차단(CLAUDE.md 최우선 원칙: 얼굴이 섞여 있을 가능성을 배제할 수 없음)
datasets/*/_raw_backup/
sheets/
face_scan_report*.csv
datasets/excluded_person_detected.csv

# 진단용 임시 산출물(라이브 재검증 중 저장한 프레임·로그) — 커밋 대상 아님
_diag_*/
live_test_*.jsonl
_raw_dataset_test/

# 학습 체크포인트(PyTorch Lightning, .ckpt) — 배포에 불필요·대용량. ONNX(weights/onnx/)와
# metadata.json만 커밋 대상이다(DESCRIPTION.md "배포 형식: ONNX" 원칙).
weights/*/lightning/
