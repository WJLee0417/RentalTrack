MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=billisan
MYSQL_USER=billisan
MYSQL_PASSWORD=changeme

# spring-dotenv가 자동 로딩(backend/.env로 복사해서 사용, .env는 gitignore 대상)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/billisan?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
SPRING_DATASOURCE_USERNAME=billisan
SPRING_DATASOURCE_PASSWORD=changeme

# 32바이트 이상 랜덤 문자열. 절대 실제 운영 시크릿을 여기 넣지 말 것.
JWT_SECRET=change-this-to-a-random-secret-at-least-32-bytes-long
JWT_EXPIRATION_SECONDS=3600
# ADMIN-AUTH-001 계약: 유휴 30분 / 절대 8시간
JWT_ADMIN_IDLE_EXPIRATION_SECONDS=1800
JWT_ADMIN_ABSOLUTE_EXPIRATION_SECONDS=28800

# 관리자 웹 CORS 허용 origin(콤마 구분).
ADMIN_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://web-sigma-two-20.vercel.app

MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=billisan-server-local

# 챗봇(CHATBOT-001) — SSAFY 기관 GMS 게이트웨이(OpenAI 호환) 발급 키. 팀 개인 Anthropic
# 구독 키는 이 프로젝트에 쓰지 않기로 확정했다. 절대 실제 키를 여기 넣지 말 것 — 실제
# 배포 값은 GitLab CI/CD Masked+Protected 변수(JWT_SECRET과 동일 방식)로 관리한다.
GMS_KEY=changeme
# CHATBOT_MESSAGE_TOO_LONG 임계값. 팀 확정 수치 아님, 기본값 그대로 써도 무방.
CHATBOT_MAX_MESSAGE_LENGTH=500

# WEATHER-001 — 기상청 API 허브(apihub.kma.go.kr) 인증키. 절대 실제 키를 여기 넣지 말 것.
KMA_API_KEY=changeme