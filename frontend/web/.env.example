# 빌리산 관리자 웹 환경 변수 예시
#
# 실제 값은 `.env.development` / `.env.local` 에 넣고 이 파일만 커밋합니다.
# 코드에서 이 값들을 읽는 곳은 `src/config/env.ts` 한 곳뿐입니다.

# ─────────────────────────────────────────────────────────── API 베이스 URL
#
# **`/api` 가 아니라 `/api/v1/admin` 입니다.**
# axios `baseURL` 이 이 값이고, 각 API 는 `/auth/login` 처럼 짧게 부릅니다.
# 그래서 `/api` 로 두면 `/api/auth/login` 이 되어 **경로가 틀립니다.**
# 관리자 Web 이 부를 수 있는 경계는 `/api/v1/admin` 아래 10개뿐입니다 (12-R B-1).
#
#  - 로컬 개발: 이 값이면 `vite.config.ts` 의 프록시(-> localhost:8080)를 탑니다.
#  - 배포(Vercel): 프론트와 백엔드가 **다른 오리진**이므로 상대 경로로 두면 Vercel
#    자신에게 요청이 갑니다. 백엔드 절대 주소를 넣으세요. 그러려면 백엔드에
#    (1) Vercel 오리진 CORS 허용 + `allowCredentials`,
#    (2) **HTTPS** 가 필요합니다. Vercel 페이지가 `https` 라 `http://` 호출은
#        브라우저가 혼합 콘텐츠로 차단합니다.
#    예) VITE_API_BASE_URL=https://i15a201.p.ssafy.io/api/v1/admin
VITE_API_BASE_URL=/api/v1/admin

# 앱 표시용 이름 (브라우저 탭 제목 등)
VITE_APP_NAME=빌리산 관리자

# ──────────────────────────────────────────────── 목업 스위치 (백엔드 연동용)
#
# **두 스위치가 따로인 이유**: 로그인 API 가 먼저 붙고 업무 데이터 API 는 나중에
# 붙습니다. 그 사이 기간에는 `VITE_MOCK_AUTH=false` + `VITE_USE_MOCK_DATA=true`
# 조합이 필요합니다.

# 로그인·세션(ADMIN-AUTH-001~003)을 목업으로 처리할지.
#  - true  : 아래 시연 계정과 대조. 서버 호출 없음
#  - false : 실제 `POST /auth/login` · `GET /auth/me` · `POST /auth/logout` 호출
VITE_MOCK_AUTH=true

# 업무 데이터(재고·슬롯·검수 7개 API)를 목업으로 처리할지.
#  - true  : `src/features/*/mocks/` 를 읽음. HTTP 호출 0건
#  - false : 실제 API 호출
VITE_USE_MOCK_DATA=true

# 로그인 화면을 건너뛰고 관리자 화면에 바로 진입할지 (개발 편의).
# 프로덕션 빌드에서는 반드시 false 여야 합니다.
VITE_AUTH_BYPASS=false

# ─────────────────────────────────────────────────────────────── 시연 계정
#
# `VITE_MOCK_AUTH=true` 일 때 로그인에 쓰는 값입니다. **값을 비워 두면 아무도
# 로그인할 수 없습니다** — 그게 기본 동작입니다.
#
# 상위 기획 §4: "P0 시연 비밀번호 원문은 저장소·문서·소스 코드에 고정하지 않고
# 실행 환경 또는 시연 운영 절차로 주입한다."
# 그래서 이 파일에는 값을 적지 않습니다. `.env.development` 나 배포 환경 변수,
# CI/CD 변수에 넣으세요.
VITE_DEMO_ADMIN_ID=
VITE_DEMO_ADMIN_PASSWORD=
